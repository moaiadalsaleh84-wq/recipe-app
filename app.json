{
  "expo": {
    "name": "Pantry Pop",
    "slug": "pantry-pop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.moaiadalsaleh.pantrypop",
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick a photo for your recipes and the dishes you cook.",
          "cameraPermission": "Take a photo of the dish you just cooked.",
          "microphonePermission": false
        }
      ],
      "expo-audio",
      "expo-asset",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/timer-alarm.wav"
          ],
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.moaiadalsaleh.pantrypop",
          "enablePushNotifications": false,
          "widgets": []
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFC83D",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ]
    ],
    "scheme": "pantrypop"
  }
}
