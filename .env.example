# Copy to .env and fill in. These are bundled into the app, so they must NOT be secrets.
# The Anthropic API key goes on the server only (see SETUP.md).

# Recipe import backend (your Supabase Edge Function URL)
EXPO_PUBLIC_IMPORT_URL=https://YOUR-PROJECT-REF.supabase.co/functions/v1/import-recipe

# Purchases: mock (test mode, default) or revenuecat (real App Store purchases, needs a dev build)
EXPO_PUBLIC_PURCHASES_MODE=mock
# RevenueCat public Apple SDK key (starts with appl_). Public by design.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
